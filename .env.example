# Socials Assistant — environment variables
# Copy to .env and fill in the values you need.
# Platform credentials: set here OR run `socials-mcp onboard` / `socials-mcp config set <key> <value>`.
# Env vars win over the config file.

# ── Vault ────────────────────────────────────────────────────────────
SOCIALS_DATA_DIR=~/.socials-assistant

# ── Platform credentials (required for each platform you use) ────────
SOCIALS_GOOGLE_CLIENT_ID=
SOCIALS_GOOGLE_CLIENT_SECRET=
SOCIALS_META_APP_ID=
SOCIALS_META_APP_SECRET=
SOCIALS_TIKTOK_CLIENT_KEY=
SOCIALS_TIKTOK_CLIENT_SECRET=

# ── HTTP mode ────────────────────────────────────────────────────────
SOCIALS_MCP_PORT=3344
SOCIALS_MCP_TOKEN=
SOCIALS_ALLOWED_ORIGINS=

# ── OAuth ────────────────────────────────────────────────────────────
SOCIALS_OAUTH_PORT=8399

# ── TikTok CSV ───────────────────────────────────────────────────────
SOCIALS_CSV_DIR=~/Downloads

# ── Outreach safety ──────────────────────────────────────────────────
SOCIALS_ALLOW_SEND=

# ── Weekly digest email (optional) ───────────────────────────────────
DIGEST_TO=
DIGEST_FROM=
RESEND_API_KEY=
