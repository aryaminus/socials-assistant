# socials-mcp cloud worker — secrets
# These appear on the Cloudflare deploy form. Values starting with CHANGE_ME are
# treated as NOT SET by the worker; the /setup page flags them and you can add
# real values later in the dashboard (Workers → your worker → Settings → Variables).

# MCP sign-in — Google OAuth client (Web application type).
# Guide: docs/onboarding-google.md (cloud variant: add <your-worker>/callback as redirect)
GOOGLE_LOGIN_CLIENT_ID=CHANGE_ME_google_web_client_id
GOOGLE_LOGIN_CLIENT_SECRET=CHANGE_ME_google_web_client_secret

# Vault token encryption — generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# Platform data apps — optional at deploy time; set later via dashboard.
# The /setup checklist walks you through each when you connect that platform.
SOCIALS_GOOGLE_CLIENT_ID=CHANGE_ME_optional
SOCIALS_GOOGLE_CLIENT_SECRET=CHANGE_ME_optional
SOCIALS_META_APP_ID=CHANGE_ME_optional
SOCIALS_META_APP_SECRET=CHANGE_ME_optional
SOCIALS_TIKTOK_CLIENT_KEY=CHANGE_ME_optional
SOCIALS_TIKTOK_CLIENT_SECRET=CHANGE_ME_optional
