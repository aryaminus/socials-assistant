// Root-level wrangler config — powers the one-click "Deploy to Cloudflare" button
// (https://deploy.workers.cloudflare.com/?url=https://github.com/aryaminus/socials-assistant).
// The button provisions the Worker, D1 database, and KV namespace automatically;
// after deploy, visit https://<your-worker>.workers.dev/setup for the guided checklist
// (secrets are set in the Cloudflare dashboard — no CLI needed).
//
// For local development of the worker itself, prefer infra/worker/wrangler.jsonc.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "socials-mcp-cloud",
  "main": "infra/worker/src/entry.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "VAULT",
      "database_name": "socials-vault",
      // "Deploy to Cloudflare" provisions a real database_id here automatically.
      // Manual deploys: `npx wrangler d1 create socials-vault` and paste the id.
      "database_id": "placeholder-provisioned-on-deploy"
    }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "placeholder-provisioned-on-deploy" }
  ],
  "vars": {
    // MCP login (Google) — create one OAuth client for sign-in (docs/onboarding-google.md §3–4)
    "GOOGLE_LOGIN_CLIENT_ID": "",
    // Creator-data platform apps — same free apps as the local onboarding guides:
    "SOCIALS_GOOGLE_CLIENT_ID": "",      // docs/onboarding-google.md (same client works)
    "SOCIALS_META_APP_ID": "",           // docs/onboarding-meta.md
    "SOCIALS_TIKTOK_CLIENT_KEY": ""      // docs/onboarding-tiktok.md
    // Secrets set in dashboard → Settings → Variables (Encrypt):
    //   GOOGLE_LOGIN_CLIENT_SECRET, SOCIALS_GOOGLE_CLIENT_SECRET,
    //   SOCIALS_META_APP_SECRET, SOCIALS_TIKTOK_CLIENT_SECRET,
    //   TOKEN_ENCRYPTION_KEY  (generate: openssl rand -hex 32 — the /setup page has a button)
  },
  "observability": { "enabled": true }
}
