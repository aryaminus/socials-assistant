{
  "name": "@aryaminus/socials-mcp",
  "version": "0.4.9",
  "description": "MCP server for social media creators — pull TikTok, Instagram, Facebook, YouTube analytics into a local vault, get weekly digests, draft brand-outreach emails with real numbers. Official APIs only, no scraping.",
  "license": "MIT",
  "type": "module",
  "author": "aryaminus <sunim.54@gmail.com> (https://github.com/aryaminus)",
  "homepage": "https://github.com/aryaminus/socials-assistant#readme",
  "bin": {
    "socials-mcp": "dist-bundle/socials-mcp.js"
  },
  "main": "dist-bundle/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist-bundle/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "bundle": "tsc -b && tsx ../../scripts/bundle.ts",
    "prepack": "tsc -b && tsx ../../scripts/bundle.ts && cp ../../README.md ../../LICENSE ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryaminus/socials-assistant.git",
    "directory": "apps/mcp"
  },
  "bugs": {
    "url": "https://github.com/aryaminus/socials-assistant/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "social-media",
    "analytics",
    "creator",
    "tiktok",
    "youtube",
    "instagram",
    "facebook",
    "outreach",
    "content-creator",
    "social-analytics",
    "vault",
    "sqlite",
    "weekly-digest",
    "brand-outreach",
    "media-kit",
    "script-review",
    "ai-agent",
    "claude",
    "chatgpt",
    "gemini",
    "cursor",
    "opencode"
  ],
  "files": [
    "dist-bundle",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@socials/shared": "workspace:*",
    "@socials/vault": "workspace:*",
    "@socials/connectors": "workspace:*"
  }
}
