{
  "name": "socials-assistant",
  "version": "0.4.1",
  "private": true,
  "description": "Open-source creator analytics MCP + agent skills: pull your own TikTok/Instagram/Facebook/YouTube data into a history vault, digest it, and draft brand outreach \u2014 from any AI agent.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -b packages/shared packages/vault packages/connectors apps/mcp",
    "typecheck": "tsc -b packages/shared packages/vault packages/connectors apps/mcp --dry",
    "test": "tsx --test packages/shared/test/*.test.ts packages/vault/test/*.test.ts packages/connectors/test/*.test.ts",
    "mcp": "node apps/mcp/bin/socials-mcp.js",
    "mcp:http": "node apps/mcp/bin/socials-mcp.js --http",
    "onboard": "node apps/mcp/bin/socials-mcp.js onboard",
    "snapshot": "node apps/mcp/bin/socials-mcp.js snapshot",
    "digest": "tsx scripts/weekly-digest.ts",
    "doctor": "node apps/mcp/bin/socials-mcp.js doctor",
    "audit": "tsx scripts/audit-mcp.ts && tsx scripts/lint-skills.ts",
    "bundle": "tsx scripts/bundle.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.34.5"
}
